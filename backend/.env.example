PORT=3000
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/waselha
JWT_SECRET=change-this-local-demo-secret
PUBLIC_BASE_URL=http://localhost:3000
# TextMe credentials stay on the backend. Enable live SMS explicitly after /api/test validation.
TEXTME_API_TOKEN=
TEXTME_USERNAME=
TEXTME_SOURCE=
TEXTME_ENABLED=false
# Android WebSocket uses the API origin. Set the exact LAN origin used by the
# phone's EXPO_PUBLIC_API_URL if it differs from PUBLIC_BASE_URL; no /api suffix.
REALTIME_ALLOWED_ORIGINS=
REDIS_URL=redis://127.0.0.1:6379
LOCATION_TTL_SECONDS=90
PRESENCE_TTL_SECONDS=45
LOCATION_FRESH_MS=15000
CUSTOMER_LINK_TTL_HOURS=
LOGIN_MAX_ATTEMPTS=
LOGIN_LOCK_MINUTES=
# Configurable pilot defaults, not permanent business rules.
DRIVER_SEARCH_TIMEOUT_MINUTES=10
DRIVER_ARRIVAL_TIMEOUT_MINUTES=20
ORDER_TIMEOUT_SWEEP_INTERVAL_MS=60000
MAPS_GEOCODER_URL=
MAPS_CONTACT=
ROUTING_BASE_URL=
ROUTING_TIMEOUT_MS=30000
QUICK_DELIVERY_ENABLED=true
LOCAL_DELIVERY_ESTIMATE_AGOROT=1500
MAPS_COUNTRY_CODES=
MAPS_MIN_INTERVAL_MS=
# Pilot / production: set NODE_ENV=production in the HOST environment before launch.
# Deployed modes do not read this development .env file. Use .env.production.example
# as a list of names to set in the host's secret store. The server refuses to start with
# the example JWT_SECRET (use `openssl rand -hex 32`), a non-HTTPS PUBLIC_BASE_URL or
# the demo accounts. See docs/pilot-operations.md.
NODE_ENV=
# Reverse-proxy hops in front of the app (usually 1), so limits/audit use the real IP.
TRUST_PROXY=
RATE_LIMIT_LOGIN_PER_MIN=
RATE_LIMIT_CUSTOMER_PER_MIN=
STUCK_ORDER_HOURS=
# Phase 4: straight-line nearby selection; no driving ETA/routing calls.
OFFER_RADIUS_KM=10
OFFER_CANDIDATE_LIMIT=5
OFFER_RECONCILE_INTERVAL_MS=5000
RATE_LIMIT_OFFERS_PER_MIN=60
# Phase 5: driver route (distance, ETA, polyline) from Google Routes, called by the backend only.
# The key stays server-side (never EXPO_PUBLIC_*). Disabled until GOOGLE_ROUTES_ENABLED=true.
# TRAFFIC_AWARE / TRAFFIC_AWARE_OPTIMAL bill under a higher Google SKU; keep TRAFFIC_UNAWARE for the pilot.
GOOGLE_ROUTES_ENABLED=false
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_ROUTING_PREFERENCE=TRAFFIC_UNAWARE
GOOGLE_ROUTES_TIMEOUT_MS=4000
GOOGLE_ROUTES_MAX_ATTEMPTS=2
ROUTE_MIN_RECALC_SECONDS=30
ROUTE_MAX_AGE_SECONDS=120
ROUTE_FAILURE_RETRY_SECONDS=10
ROUTE_OFF_ROUTE_THRESHOLD_METERS=100
ROUTE_OFF_ROUTE_CONFIRMATIONS=3
ROUTE_RATE_LIMIT_PER_MIN=12
# Offer-card ETA (driver -> pickup): one plain route per offer, cached; extra cards fall back to straight-line distance.
OFFER_ETA_MAX_AGE_SECONDS=90
OFFER_ETA_MIN_RECALC_SECONDS=45
OFFER_ETA_MOVE_METERS=250
OFFER_ETA_MAX_PER_MIN=30

# Phase 8: scoped background-upload credential; seconds (60..14400).
BACKGROUND_CREDENTIAL_TTL_SECONDS=3600

# Offer notifications for a closed or background driver app (FCM on Android, APNs on iPhone, relayed by Expo).
# Off unless PUSH_ENABLED=true. EXPO_PUSH_ACCESS_TOKEN is optional (Expo "enhanced push security").
# A closed app stops reporting its position: a push may use the last position reported within this many seconds (60-3600).
PUSH_LOCATION_MAX_AGE_SECONDS=600
PUSH_ENABLED=false
# EXPO_PUSH_ACCESS_TOKEN=

# Enable new workflow creation after deploying the v3 driver app. Existing orders can finish when false.
UNIFIED_DELIVERY_ENABLED=true
