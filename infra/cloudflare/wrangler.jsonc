{
  "name": "waselha-web",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "waselhapp.com/*", "zone_name": "waselhapp.com" }
  ],
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/socket.io", "/socket.io/*"]
  },
  "vars": {
    "BACKEND_ORIGIN": "https://waselhaapp.onrender.com"
  },
  "observability": {
    "enabled": false
  }
}
