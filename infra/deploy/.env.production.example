# Docker Compose inputs only. Copy OUTSIDE Git, e.g. /etc/waselha/infra.env (0600).
# Generate with: openssl rand -hex 32. No default password is provided.
REDIS_PASSWORD=
OSRM_DATA_DIR=/opt/waselha/osrm-data
# An immutable directory produced by scripts/setup-osrm.sh; no automatic activation.
OSRM_RELEASE=
